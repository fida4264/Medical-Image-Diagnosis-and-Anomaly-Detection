# ==============================================================================
# Medical AI Platform — Production Environment Configuration Example
# Copy to `.env` for local/container environment setup. NEVER commit `.env` with secrets.
# ==============================================================================

# Environment mode: 'development', 'testing', or 'production'
ENVIRONMENT=production
DEBUG=false

# Ports Configuration
API_PORT=8000
GRADIO_PORT=7860

# Authentication (Comma-separated valid API keys)
AUTH_REQUIRED=true
API_KEYS=replace_with_secure_api_key

# Documentation Access
ENABLE_DOCS=false

# CORS Configuration (Comma-separated origins; no wildcard '*' in production)
ALLOWED_CORS_ORIGINS=http://localhost:3000,http://localhost:7860,http://127.0.0.1:8000,http://127.0.0.1:7860

# File Upload Security Limits (Bytes)
MAX_UPLOAD_SIZE_BYTES=20971520

# Rate Limiting (Requests per minute per IP)
RATE_LIMIT_PREDICT_PER_MIN=20
RATE_LIMIT_HISTORY_PER_MIN=60
RATE_LIMIT_HEALTH_PER_MIN=120
RATE_LIMIT_DEFAULT_PER_MIN=100

# Container Resource Limits & Management
CPU_LIMIT=2.0
MEMORY_LIMIT=4G
CPU_RESERVATION=0.5
MEMORY_RESERVATION=1G

# SQLite Database Path
DATABASE_PATH=data/medical_ai.db

# Logging Level (debug, info, warning, error)
LOG_LEVEL=info
